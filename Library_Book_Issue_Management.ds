		 functions
		 {
			 Deluge
			 {
				 void Generate_GatePass_Function(int recId)
                 {
                 	// Reusable gate-pass generator. Called from the Issued workflow and the Reprint Gate Pass button.
                 	rec = Book_Issue_Request_Form[ID == recId];
                 	if(rec.count() == 0)
                 	{
                 		info "Gate pass not generated: record " + recId + " not found.";
                 		return;
                 	}
                 	// Input validation - fail safely if Member Name or Book details are missing
                 	memberName = "";
                 	if(rec.Member_Name != null)
                 	{
                 		memberName = (ifnull(rec.Member_Name.first_name,"") + " " + ifnull(rec.Member_Name.last_name,"")).trim();
                 	}
                 	if(memberName == "" || rec.Book_Catagory == null || rec.Book_Catagory == "")
                 	{
                 		info "Gate pass not generated: Member Name or Book details missing for record " + recId + ".";
                 		return;
                 	}
                 	if(rec.Email_ID == null || !rec.Email_ID.contains("@"))
                 	{
                 		info "Gate pass not generated: invalid member email for record " + recId + ".";
                 		return;
                 	}
                 	reqId = rec.ID.toString();
                 	if(rec.Issue_Request_ID != null && rec.Issue_Request_ID != "")
                 	{
                 		reqId = rec.Issue_Request_ID;
                 	}
                 	dueText = "-";
                 	if(rec.Due_Date != null)
                 	{
                 		dueText = rec.Due_Date.toString("dd-MMM-yyyy");
                 	}
                 	html = "<h2>Library Gate Pass</h2>";
                 	html = html + "<table border='1' cellpadding='6' style='border-collapse:collapse'>";
                 	html = html + "<tr><td><b>Issue Request ID</b></td><td>" + reqId + "</td></tr>";
                 	html = html + "<tr><td><b>Member Name</b></td><td>" + memberName + "</td></tr>";
                 	html = html + "<tr><td><b>Roll Number</b></td><td>" + ifnull(rec.Roll_Number,"") + "</td></tr>";
                 	html = html + "<tr><td><b>Book Category</b></td><td>" + rec.Book_Catagory + "</td></tr>";
                 	html = html + "<tr><td><b>Number of Copies</b></td><td>" + ifnull(rec.Number_of_Copies,1) + "</td></tr>";
                 	html = html + "<tr><td><b>Due Date</b></td><td>" + dueText + "</td></tr>";
                 	html = html + "<tr><td><b>Generated On</b></td><td>" + zoho.currenttime.toString("dd-MMM-yyyy HH:mm") + "</td></tr>";
                 	html = html + "</table><p>Please show this gate pass at the library exit.</p>";
                 	try 
                 	{
                 		sendmail
                 		[
                 			from :zoho.adminuserid
                 			to :rec.Email_ID
                 			subject :"Library Gate Pass - " + reqId
                 			message :html
                 		]
                 		info "Gate pass sent for record " + recId;
                 	}	catch (e)
                 	{
                 		info "Gate pass email failed for record " + recId + ": " + e;
                 	}
                 }
			 }
		 }


		workflow
		{
		form
		{
			Send_Email_Form_Propertie as "Send Email - Form Properties"
			{
				type =  presuccess
				form = Book_Issue_Request_Form
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Email_ID
							subject : "Library Book Issue Request Received - ${Roll_Number}"
							message : "<div>Dear ${Member_Name},<br><br>Thank you for submitting your book issue request. We have successfully received your application. <br><br>Here are your request details for validation:<br>- Roll Number: ${Roll_Number}<br>- Book Category:&nbsp;${Book_Catagory} - Number of Copies: ${Number_of_Copies}<br>- Preferred Collection Date: ${Preferred_Issue_Date}<br>- Preferred Collection Time: ${Preferred_Collection_Time}<br><br>Our library staff is currently checking the real-time availability of your requested items. You will receive a final confirmation notification once your books are pulled and ready at the counter.<br><br>Please ensure you visit the counter at your preferred time slot with your college ID card.<br><br>Best regards,<br>Library Management Team<br></div><br><br>"
							attachments : template : _default as inline
						)
					}
				}
			}
			Validate_Book_Issue_Reque as "Validate_Book_Issue_Request"
			{
				type =  form
				form = Book_Issue_Request_Form

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Condition 1: Restrict Number of Copies between 1 and 5
										if(input.Number_of_Copies < 1 || input.Number_of_Copies > 5)
										{
											alert "Error: You can only request between 1 and 5 copies per request.";
											cancel submit;
										}
										// Condition 2: Restrict Preferred Issue Date to disallow past dates
										if(input.Preferred_Issue_Date < zoho.currentdate)
										{
											alert "Error: Preferred Issue Date cannot be in the past.";
											cancel submit;
										}
						)
					}
				}

			}
			On_IssueRequest_Submit_Wo as "On_IssueRequest_Submit_Workflow"
			{
				type =  form
				form = Book_Issue_Request_Form

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// On_IssueRequest_Submit_Workflow - Created > Successful form submission
										reqId = input.ID.toString();
										if(input.Issue_Request_ID != null && input.Issue_Request_ID != "")
										{
											reqId = input.Issue_Request_ID;
										}
										memberName = "";
										if(input.Member_Name != null)
										{
											memberName = (ifnull(input.Member_Name.first_name,"") + " " + ifnull(input.Member_Name.last_name,"")).trim();
										}
										collectText = "during library working hours";
										if(input.Preferred_Collection_Time != null)
										{
											collectText = input.Preferred_Collection_Time.toString();
											if(input.Preferred_Issue_Date != null)
											{
												collectText = input.Preferred_Issue_Date.toString("dd-MMM-yyyy") + " at " + collectText;
											}
										}
										// 1. Confirmation to member - fail gracefully if the email is invalid (request is never blocked)
										if(input.Email_ID != null && input.Email_ID.contains("@") && input.Email_ID.contains("."))
										{
											try 
											{
												sendmail
												[
													from :zoho.adminuserid
													to :input.Email_ID
													subject :"Book Issue Request Received - " + reqId
													message :"Dear " + memberName + ",<br><br>Your book issue request has been received.<br><b>Issue Request ID:</b> " + reqId + "<br><b>Book Category:</b> " + ifnull(input.Book_Catagory,"-") + "<br><b>Expected collection time:</b> " + collectText + "<br><br>Regards,<br>Library Desk"
												]
											}	catch (e)
											{
												info "Confirmation email failed for request " + reqId + ": " + e;
											}
										}
										else
										{
											info "Invalid or missing member email for request " + reqId + " - confirmation skipped.";
										}
										// 2. Notify library counter staff
										try 
										{
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.adminuserid
												subject :"New Book Issue Request - " + reqId
												message :"A new book issue request needs processing.<br><b>Request ID:</b> " + reqId + "<br><b>Member:</b> " + memberName + " (" + ifnull(input.Roll_Number,"") + ")<br><b>Category:</b> " + ifnull(input.Book_Catagory,"-") + "<br><b>Copies:</b> " + ifnull(input.Number_of_Copies,1)
											]
										}catch (e)
										{
											info "Staff notification failed for request " + reqId + ": " + e;
										}
						)
					}
				}

			}
		}






	}
