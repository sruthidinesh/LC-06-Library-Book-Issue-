				Audio
				Requires_Home_Delivery as "Requires Home Delivery"
				Fine_Amount_Due as "Fine Amount Due"
				Late_Fee_Waiver_Percent as "Late Fee Waiver Percent"
				Total_Fine_Payable as "Total Fine Payable"
				Library_Rules_Display1 as "Library Rules Display"
