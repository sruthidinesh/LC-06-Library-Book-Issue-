				Issue_Request_ID as "Issue Request ID"
				Request_Submitted_On as "Request Submitted On"
				QR_Code as "Book Issue QR Code"
			)
		}
		kanban Issue_Status_Kanban
		{
			displayName = "Issue_Status_Kanban"
			show all rows from Book_Issue_Request_Form    
			(
				Member_Name 
				Roll_Number
				Member_Type
				Email_ID as "Email Address"
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				Residential_Address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Book_Catagory as "Book Catagory"
				Subject_Areas_of_Interest as "Subject Areas of Interest"
				Number_of_Copies as "Number of Copies"
				Purpose_of_Borrowing as "Purpose of Borrowing"
				Preferred_Issue_Date as "Preferred Issue Date"
				Preferred_Collection_Time as "Preferred Collection Time"
				Library_Rules as "Library Rules"
				Book_Title_Lookup as "Book Title Lookup"
				Book_Cover_Image as "Book Cover Image"
				Ebook_Reference_URL as "Ebook Reference URL"
				Book_Replacement_Price as "Book Replacement Price"
				Facaulty_Recommendation_Upload as "Facaulty Recommendation Upload"
				Book_Review_VIdeo as "Book Review VIdeo"
				Audio
