 application "Library Book Issue Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Book_Issue_Request_Form
		{
			success message = "Your Submission was successful! You will be receiving a conformation mail shortly."
			Section_A
			(
				type = section
				displayname = "Member Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Member_Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have unique Roll_Number
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Member_Type
			(
				type = radiobuttons
				maxchar = 100
				values = {"Student","Faculty","Staff"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Section_B
			(
				type = section
				displayname = "Contact Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Email_ID
			(
    			type = email
				displayname = "Email Address"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Contact_Number
			(
    			type = phonenumber
				displayname = "Contact Number"
    			allowedcountries={in}
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Residential_Address
			(
    			type = address
				displayname = "Residential Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Section_C
			(
				type = section
				displayname = "Book Request Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Book_Catagory
			(
				type = picklist
				displayname = "Book Catagory"
				maxchar = 100
				values = {"Computer Science","Artificial Intelligance","Data Science","Aeronotical","Machine Learning","Chemical"}
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			Subject_Areas_of_Interest
			(
				type = list	
				displayname = "Subject Areas of Interest"
				values = {"Machine Learning","Computer Science","Aeronotical","Chemical","Data Science"}
				height = 60px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Number_of_Copies
			(
				type = number
				displayname = "Number of Copies"
				maxchar = 1
	 			row = 3
	 			column = 1   
				width = medium
			)
			Purpose_of_Borrowing
			(
    			type = textarea
				displayname = "Purpose of Borrowing"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Scheduling_Acknowledgement
			(
				type = section
				displayname = "Scheduling & Acknowledgement"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Preferred_Issue_Date
			(
    			type = date
				displayname = "Preferred Issue Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			Due_Date
			(
    			type = date
				displayname = "Due Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			Preferred_Collection_Time
			(
    			type = time
				displayname = "Preferred Collection Time"
				initial value = "${zoho.currenttime}"	
				timedisplayoptions = "hh:mm:ss" 
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Library_Rules
			(
				type = checkboxes	
				displayname = "Library Rules"
				values = {"I agree to the library rules and return policy."}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Catalog_Verification_and_Reference
			(
				type = section
				displayname = "Catalog Verification and Reference"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Book_Title_Lookup
			(
				type = picklist	
				displayname = "Book Title Lookup"
				values  = Book_Issue_Request_Form.ID
    			displayformat = [Book_Catagory]
				sortorder = ascending
	 			row = 5
	 			column = 1   
				width = medium
			)
			Book_Cover_Image
			(
    			type = image
				displayname = "Book Cover Image"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 5
	 			column = 1   
				width = medium
			)
			Ebook_Reference_URL
			(
    			type = url
				displayname = "Ebook Reference URL"
				enable  linkname
	 			row = 5
	 			column = 1   
				width = medium
			)
			Book_Replacement_Price
			(
				type = decimal
				displayname = "Book Replacement Price"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Multi_Book_Request_Media_Details
			(
				type = section
				displayname = "Multi-Book Request & Media Details"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Facaulty_Recommendation_Upload
			(
    			type = upload file
				displayname = "Facaulty Recommendation Upload"
				browse = local_drive
	 			row = 6
	 			column = 1   
				width = medium
			)
			Book_Review_VIdeo
			(
    			type = video
				displayname = "Book Review VIdeo"
    			duration=30
	 			row = 6
	 			column = 1   
				width = medium
			)
			Audio
			(
     			type = audio
    			duration=60
	 			row = 6
	 			column = 1   
				width = medium
			)
			Additional_Books_Requested
			(
				type = grid
				displayname = "Additional Books Requested"
				auto width = false
				viewtype = list
				Rich_Text
				(
    				type = richtext
					displayname = "Rich Text"
					height = 200px
					toolbar = enable
					[
						style, font-color, background-color, link, bullets-and-numbering, 
						font-size : {1, 2, 3, 4, 5, 6, 7}
					]
					width = medium
				)
	 			row = 7
	 			column = 1   
				width = medium
			)
			Fine_Delivery_Preference
			(
				type = section
				displayname = "Fine & Delivery Preference"
				visibility = true
	 			row = 8
	 			column = 0   
				width = medium
			)
			must have Requires_Home_Delivery
			(
    			type = checkbox
				displayname = "Requires Home Delivery"
				initial value = false
	 			row = 8
	 			column = 1   
				width = medium
			)
			Fine_Amount_Due
			(
				displayname = "Fine Amount Due"
				type = INR
				format = commadotindian
	 			row = 8
	 			column = 1   
				width = medium
			)
			Late_Fee_Waiver_Percent
			(
    			type = percentage
				displayname = "Late Fee Waiver Percent"
				initial value = 0%
				maxchar = 3
	 			row = 8
	 			column = 1   
				width = medium
			)
			Total_Fine_Payable
			(
				type = decimal
				displayname = "Total Fine Payable"
	 			row = 8
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Fine_Amount_Due * input.Late_Fee_Waiver_Percent / 100
    						visibility = false
    			)
			)
			Declaration_System_Generated_Values
			(
				type = section
				displayname = "Declaration & System-Generated Values"
				visibility = true
	 			row = 9
	 			column = 0   
				width = medium
			)
			Library_Rules_Display1
			(
    			type = richtext
				displayname = "Library Rules Display"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 9
	 			column = 1   
				width = medium
			)
			must have Member_Digital_Signature
			(
    			type = signature
				displayname = "Member Digital Signature"
	 			row = 9
	 			column = 1   
				width = medium
				personal data = true
			)
			Auto_Number
			(
    			type = autonumber
				displayname = "Auto Number"
				start index = 1
	 			row = 9
	 			column = 1   
				width = medium
			)
			Issue_Request_ID
			(
    			type = text
				displayname = "Issue Request ID"
	 			row = 9
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  "LIB-ISS-" + zoho.currentdate.getYear() + "-" + input.Auto_Number.toString("000000")
    						visibility = false
    						format = plaintext
    			)
			)
			Request_Submitted_On
			(
    			type = datetime
				displayname = "Request Submitted On"
				initial value = "31-Jul-2026 15:36:58"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 9
	 			column = 1   
				width = medium
			)
			QR_Code
			(
				type = qrcode
				displayname = "Book Issue QR Code"
				value = "${Roll_Number}"
	 			row = 9
	 			column = 1   
				width = medium
			)
			Status
			(
				type = section
				visibility = true
	 			row = 10
	 			column = 0   
				width = medium
			)
			Issue_Status
			(
				type = picklist
				displayname = "Issue Status"
				maxchar = 100
				values = {"Requested","Approved","Issued","Returned","Overturned"}
				sortorder = ascending
	 			row = 10
	 			column = 1   
				width = medium
			)
			Book_Returned
			(
				type = checkboxes	
				displayname = "Book Returned"
				values = {"Yes","No"}
	 			row = 10
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		calendar Due_Date_Calendar
		{
			displayName = "Due_Date_Calendar"
			show all rows from Book_Issue_Request_Form    
			(
				Member_Name 
				Roll_Number
				Member_Type
				Email_ID as "Email Address"
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				Residential_Address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Book_Catagory as "Book Catagory"
				Subject_Areas_of_Interest as "Subject Areas of Interest"
				Number_of_Copies as "Number of Copies"
				Purpose_of_Borrowing as "Purpose of Borrowing"
				Preferred_Issue_Date as "Preferred Issue Date"
				Due_Date as "Due Date"
				Preferred_Collection_Time as "Preferred Collection Time"
				Library_Rules as "Library Rules"
				Book_Title_Lookup as "Book Title Lookup"
				Book_Cover_Image as "Book Cover Image"
				Ebook_Reference_URL as "Ebook Reference URL"
				Book_Replacement_Price as "Book Replacement Price"
				Facaulty_Recommendation_Upload as "Facaulty Recommendation Upload"
				Book_Review_VIdeo as "Book Review VIdeo"
				Audio
				Requires_Home_Delivery as "Requires Home Delivery"
				Fine_Amount_Due as "Fine Amount Due"
				Late_Fee_Waiver_Percent as "Late Fee Waiver Percent"
				Total_Fine_Payable as "Total Fine Payable"
				Library_Rules_Display1 as "Library Rules Display"
				Member_Digital_Signature as "Member Digital Signature"
				Auto_Number as "Auto Number"
				Issue_Request_ID as "Issue Request ID"
				Request_Submitted_On as "Request Submitted On"
				QR_Code as "Book Issue QR Code"
				Issue_Status as "Issue Status"
				Book_Returned as "Book Returned"
				Book_Title_Lookup.Email_ID as "Email Address"
			)
			options
			(
				display field = Book_Title_Lookup
				start date = Preferred_Issue_Date
				end date = Due_Date
			)
		}
		timeline Issue_Activity_Timeline
		{
			displayName = "Issue_Activity_Timeline"
			show all rows from Book_Issue_Request_Form    
			(
				Member_Name 
				Roll_Number
				Member_Type
				Email_ID as "Email Address"
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				Residential_Address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Book_Catagory as "Book Catagory"
				Subject_Areas_of_Interest as "Subject Areas of Interest"
				Number_of_Copies as "Number of Copies"
				Purpose_of_Borrowing as "Purpose of Borrowing"
				Preferred_Issue_Date as "Preferred Issue Date"
				Due_Date as "Due Date"
				Preferred_Collection_Time as "Preferred Collection Time"
				Library_Rules as "Library Rules"
				Book_Title_Lookup as "Book Title Lookup"
				Book_Cover_Image as "Book Cover Image"
				Ebook_Reference_URL as "Ebook Reference URL"
				Book_Replacement_Price as "Book Replacement Price"
				Facaulty_Recommendation_Upload as "Facaulty Recommendation Upload"
				Book_Review_VIdeo as "Book Review VIdeo"
				Audio
				Requires_Home_Delivery as "Requires Home Delivery"
				Fine_Amount_Due as "Fine Amount Due"
				Late_Fee_Waiver_Percent as "Late Fee Waiver Percent"
				Total_Fine_Payable as "Total Fine Payable"
				Library_Rules_Display1 as "Library Rules Display"
				Member_Digital_Signature as "Member Digital Signature"
				Auto_Number as "Auto Number"
				Issue_Request_ID as "Issue Request ID"
				Request_Submitted_On as "Request Submitted On"
				QR_Code as "Book Issue QR Code"
				Issue_Status as "Issue Status"
				Book_Returned as "Book Returned"
			)
			options
			(
				display field = Issue_Request_ID
				start date = Preferred_Issue_Date
				end date = Due_Date
			)
		}
		default list Book_Issue_Request_Form_Report
		{
			displayName = "Book_Issue_Request_Form Report"
			show all rows from Book_Issue_Request_Form    
			(
				Member_Name 
				Member_Type
				Roll_Number
				Email_ID as "Email Address"
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				Residential_Address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Book_Catagory as "Book Catagory"
				Subject_Areas_of_Interest as "Subject Areas of Interest"
				Number_of_Copies as "Number of Copies"
				Purpose_of_Borrowing as "Purpose of Borrowing"
				Preferred_Issue_Date as "Preferred Issue Date"
				Preferred_Collection_Time as "Preferred Collection Time"
				Library_Rules as "Library Rules"
				Book_Cover_Image as "Book Cover Image"
				Ebook_Reference_URL as "Ebook Reference URL"
				Book_Replacement_Price as "Book Replacement Price"
