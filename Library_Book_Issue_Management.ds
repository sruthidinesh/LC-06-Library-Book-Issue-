		menu
		{
			space Space
			{
				displayname = "Space"
				icon = "objects-spaceship"

				section Book_Issue_Request_Form
				{
					displayname = "Book_Issue_Request_Form"
					icon = "tech-desktop"
					form  Book_Issue_Request_Form
					{
						icon = "tech-desktop"
					}
					report Book_Issue_Request_Form_Report
					{
						icon = "tech-desktop"
					}
					report All_Issue_Requests_List
					{
						icon = "tech-desktop"
					}
					report Issue_Requests_Spreadsheet
					{
						icon = "tech-desktop"
					}
					report Issue_Status_Kanban
					{
						icon = "tech-desktop"
					}
					report Member_Hostel_Map
					{
						icon = "tech-desktop"
					}
					report Due_Date_Calendar
					{
						icon = "tech-desktop"
					}
					report Issue_Activity_Timeline
					{
						icon = "tech-desktop"
					}
				}
				section App_Preferences
				{
					displayname = "App Preferences"
					icon = "design-app"
					systemcomponent
					{
						type = localization
						displayname = "Language Selection"
						icon = "education-language"
					}
					systemcomponent
					{
						type = connection
						displayname = "Integrations"
						icon = "tech-2-connection"
					}
				}
				section Approvals
				{
					displayname = "Approvals"
					icon = "ui-2-hourglass"
					systemcomponent
					{
						type = approval
						approval status = pending
						displayname = "Pending Tasks"
						icon = "ui-2-hourglass"
					}
					systemcomponent
					{
						type = approval
						approval status = completed
						displayname = "Completed Tasks"
						icon = "design-todo"
					}
				}
				section SharedAnalytics_Section
				{
					type = shared_user_report_section
					displayname = "Reports"
					icon = "business-chart-bar-33"
				}
				section Library_Command_Center_Page
				{
					displayname = "Library_Command_Center_Page"
					icon = "tech-desktop"
					page Library_Command_Center_Page
					{
						icon = "tech-desktop"
					}
				}
			}
			preference
			{
				icon
				{
					style = outline
				}
			}
		}
		customize
		{
			font = "lato"
			color options
			{
				color = "11"
			}
			logo
			{
				preference = "app_icon"
				placement = "left"
			}
		}
	}
	phone
	{
		forms
		{
			form Book_Issue_Request_Form
			{
				label placement = auto
			}
		}
		customize
		{
			layout = twocolumn
			font = "default"
			style = "3"
			color options
			{
				color = chryslerpurple
			}
			logo
			{
				preference = "none"
			}
		}
	}
	tablet
	{
		forms
		{
			form Book_Issue_Request_Form
			{
				label placement = auto
			}
		}
		customize
		{
			layout = slidingpane
			font = "default"
			style = "3"
			color options
			{
				color = lightred
			}
			logo
			{
				preference = "none"
			}
		}
	}
